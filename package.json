{
  "name": "flamingo-node",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "lib/flamingo.js",
  "imports": {
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    }
  },
  "scripts": {
    "fw": "node lib/cli.js",
    "backup:poc": "bare lib/hyperdrive-poc.js",
    "docs": "bare scripts/docs.js",
    "docs:flamingo": "bare docs.js",
    "lint": "standardx --fix --eslint"
  },
  "bin": {
    "cli": "scripts/cli.js",
    "fw": "lib/cli.js"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "b4a": "1.8.1",
    "bare": "1.33.0",
    "bare-crypto": "1.15.3",
    "bare-daemon": "1.2.4",
    "bare-fs": "4.8.1",
    "bare-module": "7.0.1",
    "bare-os": "3.9.3",
    "bare-path": "3.1.2",
    "bare-process": "4.5.1",
    "bare-runtime": "1.33.0",
    "bare-stream": "2.13.4",
    "bare-subprocess": "6.1.0",
    "bare-url": "2.5.4",
    "bare-ws": "3.1.0",
    "bip39-mnemonic": "2.5.0",
    "corestore": "6.18.4",
    "flamingo-docker": "git+https://github.com/basim-12/flamingo-docker.git#b935a37addc1587a44a82bbbecc05f6d7a7ea976",
    "hypercore-id-encoding": "1.3.0",
    "hyperdrive": "11.13.4",
    "localdrive": "2.2.1",
    "mirror-drive": "1.10.0",
    "ws": "^8.16.0"
  },
  "overrides": {
    "hypercore": "10.38.2",
    "hyperbee": "2.26.5"
  },
  "devDependencies": {
    "brittle": "4.2.0",
    "standardx": "^7.0.0"
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "browser": true,
      "es2021": true
    },
    "extends": [
      "standard"
    ],
    "rules": {
      "camelcase": "off",
      "no-unused-vars": "off"
    },
    "ignorePatterns": [
      "node_modules",
      "dist"
    ]
  }
}
